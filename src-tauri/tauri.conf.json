{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finer",
  "version": "1.2.0",
  "identifier": "app.finer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finer",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": { "rife/": "rife/" },
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Video quality and motion rendering tool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
